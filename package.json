    "network",
    "offline",
    "connectivity",
    "status-banner",
    "composable"
  ],
  "author": "Janaka Edirisinghe",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "vite": "^5.4.2",
    "vue": "^3.4.38"
  }
